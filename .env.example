# ============================================================
# DigiQ Environment Variables Template (.env.example)
# Salin file ini menjadi .env (atau .env.local) untuk deployment lokal:
#   cp .env.example .env
# ============================================================

# Server Configuration
HOST=0.0.0.0
PORT=9000

# Public Domain / Cloudflare Zero Trust Tunnel Hostname
PUBLIC_SITE_URL=https://enikzrad.web.id

# Supabase Credentials (Anon Key publik yang dilindungi RLS)
# DILARANG MENGGUNAKAN SERVICE_ROLE_KEY DI SINI!
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
